          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-hyrox"
          },
          "query": "from(bucket: \"telemetry\")\n  |> range(start: -10s)\n  |> filter(fn: (r) => r._measurement == \"biometrics\" and r._field == \"heart_rate\")\n  |> group(columns: [\"athlete_id\"])\n  |> last()\n  |> keep(columns: [\"athlete_id\", \"phase\", \"phase_type\"])\n  |> group()",
          "refId": "A"
        }
      ],
